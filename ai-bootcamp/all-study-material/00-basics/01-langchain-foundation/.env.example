# Copy this file to .env and paste your API key:
#   cp .env.example .env

# Option A — OpenAI (default)
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste-your-openai-key-here

# Optional: override the default model (gpt-5.6-sol)
# OPENAI_MODEL=gpt-5.6-sol

# Option B — Groq (free tier, OpenAI-compatible; comment out Option A above)
# Get a key: https://console.groq.com/keys
# OPENAI_API_KEY=gsk_paste-your-groq-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Local model (Ollama) — used by 03_summary_chain_ollama.py and "04 --local"
# OLLAMA_MODEL=gemma3:270m

# Optional — LangSmith tracing (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_paste-your-langsmith-key-here
# LANGSMITH_PROJECT=section-01-langchain-foundations
