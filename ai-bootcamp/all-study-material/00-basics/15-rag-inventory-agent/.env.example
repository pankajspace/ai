# Copy this file to .env and paste your OpenAI API key:
#   cp .env.example .env
# (load_dotenv() in starter/solution scripts searches this folder and parent folders.)

# Required — used by ChatOpenAI in scripts 04–08
OPENAI_API_KEY=sk-paste-your-openai-key-here

# Optional — HuggingFace token to avoid rate limits when downloading local embedding models
# HF_TOKEN=hf_paste-your-token-here
