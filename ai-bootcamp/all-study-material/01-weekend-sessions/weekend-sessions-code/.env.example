# Weekend Sessions — Repo-root environment settings
# Copy this file to .env and fill in the provider you are using:
#   cp .env.example .env

# ── Option A: Groq (free tier, used by *_groq notebooks & scripts) ────
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=gsk_paste-your-groq-key-here
# Optional overrides:
# GROQ_MODEL_ID=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Option B: AWS / Amazon Bedrock ────────────────────────────────────
# AWS_PROFILE=your-profile-name
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# AWS_PAGER=

# ── Optional section-specific keys ────────────────────────────────────
# Section 4 — Multi-agent patterns (Tavily web search + Alpha Vantage finance)
# TAVILY_API_KEY=tvly-paste-your-tavily-key-here
# ALPHA_VANTAGE_API_KEY=paste-your-alpha-vantage-key-here

# Section 7 — Observability (Langfuse, LangSmith, Datadog)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=strands-agents-demo
# DD_API_KEY=paste-your-datadog-api-key-here
# DD_SITE=datadoghq.com
