# Section 3 — Agent Memory (Groq or AWS Bedrock + Mem0 / AgentCore Memory)
# Copy to .env here or in weekend-sessions-code/:
#   cp .env.example .env

# Option A — Groq (*_groq notebooks)
GROQ_API_KEY=gsk_paste-your-groq-key-here
# GROQ_MODEL_ID=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Option B — AWS Bedrock / AgentCore Memory
# AWS_PROFILE=your-profile-name
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# (02-langgraph-agentcore-memory defaults to global.anthropic.claude-haiku-4-5-20251001-v1:0)

# Optional — Mem0 & Strands tool settings
# MEM0_DIR=./.mem0
# MEM0_TELEMETRY=false
# BYPASS_TOOL_CONSENT=true
