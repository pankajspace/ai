# Section 7 — Evals, Observability, and Governance
# Copy to .env here or in weekend-sessions-code/:
#   cp .env.example .env

# ── Option A: Groq (*_groq notebooks & scripts) ──────────────────────
GROQ_API_KEY=gsk_paste-your-groq-key-here
# GROQ_MODEL_ID=openai/gpt-oss-120b
# GROQ_JUDGE_MODEL_ID=openai/gpt-oss-120b
# GUARDRAIL_MODEL_ID=openai/gpt-oss-safeguard-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Option B: AWS Bedrock ────────────────────────────────────────────
# AWS_PROFILE=your-profile-name
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# (agent-evaluation defaults to global.anthropic.claude-haiku-4-5-20251001-v1:0)

# ── Observability: Langfuse (03_langfuse_tracing & otel-collector) ───
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Observability: LangSmith (04_langsmith_tracing) ──────────────────
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=strands-agents-demo

# ── Observability: Datadog (otel-collector/run_collector.sh) ─────────
# DD_API_KEY=paste-your-datadog-api-key-here
# DD_SITE=datadoghq.com

# ── Observability: OpenTelemetry / Jaeger (02_jaeger_tracing) ────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=strands-agents-demo
