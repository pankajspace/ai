# Copy to .env (same folder) and fill in your keys:  cp .env.example .env
# Every script and container reads this one shared file.

# OpenAI - 01, 03, 04, 05, 10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq - 02, and 06/07 when PROVIDER = "groq" (free key: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini - 06/07 when PROVIDER = "gemini" (free key: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
