# InterviewIQ Environment Variables

# OpenAI API Key (Primary - get yours at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Groq API Key (Alternative - fast and free at https://console.groq.com)
# If set, Groq takes priority over OpenAI. Leave blank to use OpenAI.
GROQ_API_KEY=

# Optional Model Override:
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# For Groq:   llama-3.3-70b-versatile, llama-3.1-8b-instant
MODEL_NAME=gpt-4o-mini
