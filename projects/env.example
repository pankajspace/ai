# ==============================================================================
# Master Environment Variables Example (env.example)
# Consolidated configuration for all projects under the `projects/` directory
# ==============================================================================
# Usage:
#   1. Copy this file to `.env`:
#        cp env.example .env
#      or copy into a specific project folder:
#        cp env.example projects/<project-dir>/.env
#   2. Replace placeholder values with your actual credentials.
#   3. Never commit `.env` files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Credentials & Endpoints
# ------------------------------------------------------------------------------

# OpenAI
# Used in: 01-ai-basics, 02-langchain-agents, 03-ai-rag-chroma,
#          04-ai-model-training-chromadb, 06-ai-systems, 07-ai-reliability,
#          09-interviewiq (fallback), 10-shipment-exception-desk, template
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq Cloud
# Used in: 01-ai-basics, 02-langchain-agents, 06-ai-systems,
#          08-ai-mcp-evals, 09-interviewiq (primary evaluator)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (OpenAI-compatible endpoint)
# Used in: 06-ai-systems (multi-model benchmarking)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 2. AWS Bedrock Configuration
# ------------------------------------------------------------------------------
# Used in: 05-ai-aws-strands
# Note: For local development, set AWS credentials below. In production on EC2,
# IAM roles/instance profiles provide credentials automatically.
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_NOVA_LITE=amazon.nova-lite-v1:0

# ------------------------------------------------------------------------------
# 3. Vector Database & Cache
# ------------------------------------------------------------------------------
# Used in: 04-ai-model-training-chromadb
# Note: If left blank or unreachable, falls back to in-memory EphemeralClient/dict.
CHROMA_HOST=
CHROMA_PORT=8000
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Search & External Services
# ------------------------------------------------------------------------------
# Used in: techtoday
ELASTIC_IP=your.elasticsearch.ip.address

# ------------------------------------------------------------------------------
# 5. Application Runtime & Framework Settings
# ------------------------------------------------------------------------------
# Application URL prefix when proxied behind reverse proxy (Nginx)
# e.g., /01-ai-basics, /09-interviewiq, /10-shipment-exception-desk
PATH_PREFIX=

# Application environment and logging
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_S=5

# Agent tool execution: bypass consent prompt for automated/headless runs
# Used in: 05-ai-aws-strands tools & tests
BYPASS_TOOL_CONSENT=true

# Model artifact serialization path
# Used in: 04-ai-model-training-chromadb
MODEL_PATH=/tmp/eta_model.pkl

