# Configuration for the project automation scripts (new-project.sh,
# provision-project.sh). Copy this file to `.env` and fill in your values:
#
#   cp .env.example .env
#
# `.env` is gitignored. Any value left unset here falls back to the default
# defined in lib.sh. You can also override any variable inline, e.g.:
#   AWS_REGION=eu-west-1 ./provision-project.sh ai-03

# --- AWS ---
# AWS region hosting ECR, Secrets Manager, and the EC2 instance.
AWS_REGION=us-east-1
# ECR repositories are namespaced under this prefix, e.g. techtoday/basic.
ECR_NAMESPACE=techtoday
# Name of the single shared Secrets Manager secret that holds API keys.
SECRET_ID=techtoday/secrets

# --- EC2 host ---
# Public IP / hostname of the EC2 instance that runs the containers.
ELASTIC_IP=your.ec2.elastic.ip
# SSH user and key used to reach the EC2 instance.
EC2_USER=ec2-user
SSH_KEY=techtoday.pem

# --- Remote paths on EC2 ---
REMOTE_COMPOSE=~/docker-compose.yml
REMOTE_SECRETS_DIR=~/secrets
REMOTE_NGINX_CONF=/etc/nginx/conf.d/app.conf

# --- Domains & ports ---
# The app subdomain that Nginx serves container projects under.
APP_DOMAIN=app.techtoday.click
# Local host port base (repo docker-compose.yml): first project 8080, next 8081, ...
LOCAL_BASE_PORT=8080
# Production host port base (EC2 docker-compose.yml): first project 5000, next 5001, ...
PROD_BASE_PORT=5000

# --- Scaffolding ---
# Default template project cloned by new-project.sh.
TEMPLATE_PROJECT=langchain
