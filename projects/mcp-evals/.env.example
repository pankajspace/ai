# Copy this file to .env and fill in real values for local development.
# .env is gitignored and must never be committed.

# Required by the Cricket Agent and Eval Suite tiles (MCP Plumbing needs no key).
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model. It must support tool calling.
# DEMO_MODEL=openai/gpt-oss-20b
