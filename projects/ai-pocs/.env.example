# Client Configuration
VITE_SERVER_URL=http://localhost:8000

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Keys
OPENAI_API_KEY=openai_api_key_here
GROQ_API_KEY=groq_api_key_here
GEMINI_API_KEY=gemini_api_key_here

# Models & Endpoints
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# AWS Bedrock Configuration (required by the Strands/LangGraph services 11-22; use read-only credentials)
# Set them for local Docker runs; leave empty in production to use the EC2 instance role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_NOVA_LITE=amazon.nova-lite-v1:0