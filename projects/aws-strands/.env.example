# Copy this file to .env and fill in real values for local development.
# .env is gitignored and must never be committed.
#
# The demos run real Strands agents on Amazon Bedrock, so AWS credentials with
# Bedrock model access are required locally. In production the EC2 instance role
# supplies these automatically, so these vars are not set on the server.
#
# Temporary sessions (e.g. `aws login`, SSO, or STS) also require
# AWS_SESSION_TOKEN. Export the currently-resolved credentials into this file
# with:  aws configure export-credentials --format env-no-export > .env
# then re-append AWS_DEFAULT_REGION below. Re-run after each `aws login`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Optional: override the default Bedrock model (see src/python/config.py).
# MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
