#!/usr/bin/env bash
# Managed by Terraform (modules/config). Regenerates each container app's env
# file from the shared techtoday/secrets secret (ADD_PROJECT.md § 7.2).
# Every app receives the full key set, matching the existing convention.
set -euo pipefail

REGION="${region}"
SECRET_JSON="$(aws secretsmanager get-secret-value \
  --secret-id techtoday/secrets \
  --region "$REGION" \
  --query SecretString --output text)"

mkdir -p /home/ec2-user/secrets

for name in ${project_names}; do
  printf '%s' "$SECRET_JSON" | \
    python3 -c "import sys,json; d=json.load(sys.stdin); print('\n'.join(f'{k}={v}' for k,v in d.items()))" \
    > "/home/ec2-user/secrets/$name.env"
  chmod 600 "/home/ec2-user/secrets/$name.env"
done

echo "Regenerated env files for: ${project_names}"
