# Managed by Terraform (modules/config). Do not edit by hand — changes are
# overwritten on the next `terraform apply`. Add container apps via the
# container_projects map in infra/terraform/variables.tf.
%{ for name, cfg in projects ~}
location /${name}/ {
    proxy_pass         http://localhost:${cfg.host_port};
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
}
%{ endfor ~}
