# Copy to terraform.tfvars and fill in your values, then `terraform apply`.
# terraform.tfvars is git-ignored by the .gitignore in this folder.

# --- Required -----------------------------------------------------------------
github_org  = "YOUR_GITHUB_ORG_OR_USERNAME"
github_repo = "YOUR_REPO_NAME"

# --- Optional (defaults shown) ------------------------------------------------
# aws_region           = "us-east-1"
# domain_name          = "techtoday.click"
# app_subdomain        = "app"
# instance_type        = "t2.micro"
# key_name             = "techtoday_PAIR"
# ssh_private_key_path = "~/.ssh/techtoday.pem"
# github_branch        = "main"

# --- Container apps ------------------------------------------------------------
# NOT set here. The container app list lives in projects.auto.tfvars.json and is
# managed by scripts/new-project.sh (make new-project). Terraform auto-loads it.
